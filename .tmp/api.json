<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Request Blocked | Brawlify</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="192x192" href="/images/favicon-192.png" />
  <style>
    /* Brand display font — self-hosted, same source as the main site (design/BRAND.md) */
    @font-face {
      font-family: 'TotalBlack VF';
      src: url('data:font/otf;base64,') format('opentype');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      /* Per-page accent (RGB channels) — pink for block/error, lime for transient */
      --accent-rgb: 255, 0, 122;
      --font-sans: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
      --font-display: 'TotalBlack VF', 'Inter', 'Segoe UI', system-ui, sans-serif;
      --font-mono: 'Aglet Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      font-family: var(--font-sans);
      background-color: #161618;
      background-image: radial-gradient(ellipse 65% 55% at 50% -12%, rgba(var(--accent-rgb), 0.09), transparent 70%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 1.5rem;
    }

    /* ── Card ── */
    .card {
      position: relative;
      background-color: #1e1e21;
      border: 1px solid #34343b;
      border-radius: 1.25rem;
      padding: 2.5rem 2rem;
      max-width: 460px;
      width: 100%;
      text-align: center;
      box-shadow: 0 24px 70px -28px rgba(0, 0, 0, 0.85);
      animation: fade-in 0.6s ease-out;
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 1px;
      border-radius: 1.25rem 1.25rem 0 0;
      background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.55), transparent);
    }

    /* ── Brand wordmark ── */
    .brand {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: #ffffff;
      opacity: 0.9;
      margin-bottom: 1.75rem;
    }

    /* ── Icon ── */
    .icon-wrapper {
      position: relative;
      width: 84px;
      height: 84px;
      margin: 0 auto 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(var(--accent-rgb), 0.07);
      border: 1px solid rgba(var(--accent-rgb), 0.18);
    }

    /* Glow as a separate layer — animating opacity is composited (no per-frame repaint) */
    .icon-wrapper::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 26px 3px rgba(var(--accent-rgb), 0.3);
      opacity: 0;
      animation: pulse-glow 2.4s ease-in-out infinite;
      pointer-events: none;
    }

    .icon-wrapper svg {
      width: 40px;
      height: 40px;
      color: rgb(var(--accent-rgb));
    }

    /* ── Heading ── */
    h1 {
      font-size: 1.4rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.6rem;
      letter-spacing: -0.01em;
    }

    /* ── Message ── */
    .message {
      color: #b0b0b0;
      font-size: 0.9375rem;
      line-height: 1.6;
      margin: 0 auto 1.75rem;
      max-width: 360px;
    }

    /* ── Cloudflare error box (used by 5xx / 1xxx pages) ── */
    .cf-token-box {
      margin: 1.75rem 0;
      padding: 1rem;
      min-height: 64px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: #161618;
      border: 1px solid #2c2c33;
      border-radius: 0.85rem;
      color: #b0b0b0;
      font-size: 0.875rem;
      text-align: center;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
      overflow-wrap: anywhere;
    }

    /* Cloudflare replaces the token with its own markup (headings, detail
       lists, long unbreakable URLs, challenge widgets). Constrain that
       arbitrary content so it can never overflow the card. */
    .cf-token-box * {
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
      overflow-wrap: anywhere;
    }
    .cf-token-box img { max-width: 100%; height: auto; }
    .cf-token-box iframe { max-width: 100%; }
    .cf-token-box a { color: #d3fb4b; }
    .cf-token-box ul { list-style: none; margin: 0; padding: 0; }
    .cf-token-box p { margin: 0; }

    /* ── Buttons ── */
    .buttons {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 0;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      border-radius: 0.75rem;
      transition: all 0.2s ease;
      cursor: pointer;
      border: none;
      min-width: 130px;
    }

    .btn-primary {
      background-color: #d3fb4b;
      color: #161618;
      box-shadow: 0 2px 0 #6b8022, 0 4px 14px rgba(211, 251, 75, 0.3);
    }

    .btn-primary:hover {
      background-color: #caf242;
      transform: translateY(-2px);
      box-shadow: 0 2px 0 #6b8022, 0 6px 20px rgba(211, 251, 75, 0.4);
    }

    .btn-secondary {
      background-color: #26262a;
      color: #ffffff;
      border: 1px solid #34343b;
    }

    .btn-secondary:hover {
      background-color: #2e2e33;
      border-color: #555555;
      transform: translateY(-2px);
    }

    /* ── Support link ── */
    .support {
      margin-top: 1.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid #2c2c33;
    }

    .support a {
      color: #ff007a;
      text-decoration: none;
      font-size: 0.875rem;
      transition: color 0.2s ease;
    }

    .support a:hover {
      color: #ff4b89;
    }

    /* ── Connection details (privacy-gated) ── */
    .details {
      margin-top: 1.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid #2c2c33;
    }

    .details-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin: 0 auto;
      padding: 0.5rem 0.9rem;
      font-family: inherit;
      font-size: 0.75rem;
      font-weight: 500;
      color: #8a9099;
      background: transparent;
      border: 1px solid #34343b;
      border-radius: 0.6rem;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }

    .details-toggle:hover {
      color: #c5c9cf;
      border-color: #4a4a52;
    }

    .details-toggle svg {
      width: 13px;
      height: 13px;
    }

    /* Hidden by default in CSS — values never render on screen unless explicitly revealed */
    .details-body {
      display: none;
      margin-top: 0.85rem;
    }

    .details-body.is-open {
      display: block;
      animation: fade-in 0.3s ease-out;
    }

    .details-panel {
      text-align: left;
      background: #161618;
      border: 1px solid #2c2c33;
      border-radius: 0.7rem;
      padding: 0.85rem 1rem;
    }

    .details-row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.3rem 0;
      font-size: 0.75rem;
    }

    .details-row + .details-row {
      border-top: 1px solid #232329;
    }

    .details-row dt {
      color: #6f7681;
      flex-shrink: 0;
    }

    .details-row dd {
      color: #c5c9cf;
      font-family: var(--font-mono);
      text-align: right;
      word-break: break-all;
    }

    .details-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      margin-top: 0.65rem;
      font-size: 0.6875rem;
      color: #6f7681;
    }

    .details-note svg {
      width: 12px;
      height: 12px;
      flex-shrink: 0;
    }

    .details-hide {
      margin-top: 0.5rem;
      padding: 0.3rem 0;
      font-family: inherit;
      font-size: 0.6875rem;
      color: #8a9099;
      background: none;
      border: none;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .details-hide:hover {
      color: #c5c9cf;
    }

    /* ── Animations ── */
    @keyframes pulse-glow {
      0%, 100% {
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ── Reduced motion ── */
    @media (prefers-reduced-motion: reduce) {
      .card,
      .details-body.is-open {
        animation: none;
      }

      .icon-wrapper::before {
        animation: none;
        opacity: 0.4;
      }

      .btn-primary:hover,
      .btn-secondary:hover {
        transform: none;
      }
    }

    /* ── Mobile (480px) ── */
    @media (max-width: 480px) {
      body {
        padding: 1rem;
      }

      .card {
        padding: 2rem 1.25rem;
      }

      h1 {
        font-size: 1.25rem;
      }

      .icon-wrapper {
        width: 72px;
        height: 72px;
      }

      .icon-wrapper svg {
        width: 34px;
        height: 34px;
      }

      .buttons {
        flex-direction: column;
      }

      .btn {
        min-width: 0;
        width: 100%;
      }
    }
  </style>
</head>
